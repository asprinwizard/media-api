# Media02 (new site) — Apache vhost.
#
# Based on the live media.aspdendev.com vhost (2026-11-18), with these changes:
#   - Basic auth for the whole site lives here (not in .htaccess), covering
#     every HTTP method; auth files moved to /etc/apache2/media-auth/
#   - /public and /hls now require login (both were open to the internet)
#   - restricted library folders are admin-only for direct /media links too
#   - the media-web SERVER_ROOT / INCLUDEPATH env vars are no longer needed
#
# Install as /etc/apache2/sites-available/media-new.aspdendev.com.conf. The TLS certificate
# comes from certbot (see .documentation/media-site/staging-setup.md).
# When the site moves to media.aspdendev.com, change both ServerName lines,
# the certificate paths and APP_URL in media-api/.env.
#
# Modules: php8.4, rewrite, authz_groupfile, proxy, proxy_http,
#          headers, ssl.

<VirtualHost *:80>
    ServerName media-new.aspdendev.com
    # Plain HTTP only redirects (certbot's renewal also uses port 80).
    RewriteEngine on
    RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [END,NE,R=permanent]
</VirtualHost>

<VirtualHost *:443>
    ServerName media-new.aspdendev.com

    SSLEngine on
    SSLCertificateFile    /etc/letsencrypt/live/media-new.aspdendev.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/media-new.aspdendev.com/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    ErrorLog  /var/log/apache2/media-new-error.log
    CustomLog /var/log/apache2/media-new-access.log combined

    # --- Basic auth: every path, every HTTP method (no <Limit>) --------------
    <Location />
        AuthType Basic
        AuthName "Media02"
        AuthUserFile  /etc/apache2/media-auth/.htpasswd
        AuthGroupFile /etc/apache2/media-auth/.htgroup
        Require group admin ftp standard
    </Location>

    # --- SPA (media-app/dist) -------------------------------------------------
    DocumentRoot /home/sites/media-app/dist
    <Directory /home/sites/media-app/dist>
        Options -Indexes
        AllowOverride None
        # Unknown paths (e.g. /library/TV/Drama) load the SPA
        FallbackResource /index.html
    </Directory>

    # --- API (media-api) under /api --------------------------------------------
    # Laravel sees /api as its base path, so its routes have no /api prefix.
    Alias /api /home/sites/media-api/public
    <Directory /home/sites/media-api/public>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        DirectoryIndex index.php
        RewriteEngine On
        RewriteBase /api
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteRule ^ index.php [L]
    </Directory>

    # Large uploads. Apache's default body limit is 1 GB; PHP (32-bit) caps
    # files at upload_max_filesize = 1900M, post_max_size = 1950M, with
    # max_input_time = 3600 and upload_tmp_dir on the big drive (php.ini).
    <Location /api/uploads>
        LimitRequestBody 2097152000
    </Location>

    # --- Media files: always served by Apache, never by PHP -------------------
    # (PHP is 32-bit here and can't handle files over 2 GB; mod_xsendfile fails
    # with "unable to stat file" on these drives.) Apache handles Range/seeking.
    Alias /media/ "/home/share/"
    <Directory /home/share/>
        Options FollowSymLinks
        AllowOverride None
        # /api/files/download logs the download, then redirects here with
        # ?download, which makes the browser save the file instead of playing it
        <If "%{QUERY_STRING} =~ /(^|&)download(=|&|$)/">
            Header set Content-Disposition "attachment"
        </If>
    </Directory>
    # Restricted library folders: admins only, also for direct links
    <LocationMatch "^/media/Video/(Torrent Downloads|Uploaded Files)(/|$)">
        Require group admin
    </LocationMatch>

    # --- Queue files, activity logs, iPlayer info: admins only ---------------
    Alias /public/ "/home/public/media/"
    <Directory "/home/public/media/">
        Options FollowSymLinks
        AllowOverride None
    </Directory>
    <Location /public/>
        Require group admin
    </Location>

    # --- Chromecast links: no login ------------------------------------------
    # /api/files/cast makes /home/public/cast/<32 random hex>/<file> -> real
    # file; the random folder name is the secret. No directory listing (no
    # Indexes), so tokens can't be discovered. Removed after 24 hours.
    Alias /shared/ "/home/public/cast/"
    <Directory "/home/public/cast/">
        Options FollowSymLinks
        AllowOverride None
        <If "%{QUERY_STRING} =~ /(^|&)download(=|&|$)/">
            Header set Content-Disposition "attachment"
        </If>
    </Directory>
    <Location /shared/>
        Require all granted
    </Location>

    # --- Live TV: HLS from the tuner box (admins only) -----------------------
    ProxyPass        /hls/ http://192.168.1.115:1706/hls/
    ProxyPassReverse /hls/ http://192.168.1.115:1706/hls/
    <Location /hls/>
        Require group admin
    </Location>
</VirtualHost>
