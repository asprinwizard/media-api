APP_NAME=Media02
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public URL of the site. The only place the domain is stored: change it when
# the site moves from the staging subdomain to its final URL.
APP_URL=https://media-new.aspdendev.com

# Times in activity logs match the old site (UK local time)
APP_TIMEZONE=Europe/London

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# No database. Stateless API: no sessions, file cache, synchronous queue.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# --- Auth ------------------------------------------------------------------
# Same file Apache uses for AuthGroupFile (read-only here).
MEDIA_HTGROUP_FILE=/etc/apache2/media-auth/.htgroup

# Local development without Apache. Needs APP_ENV=local as well, and only
# applies to requests from 127.0.0.1. Never set these in production.
MEDIA_DEV_AUTH=false
MEDIA_DEV_USER=
MEDIA_DEV_ROLES=

# --- Paths -----------------------------------------------------------------
MEDIA_SHARE_PATH=/home/share
MEDIA_LIBRARY_PATH=/home/share/Video
MEDIA_UPLOAD_PATH=/home/ftp/media
MEDIA_PUBLIC_PATH=/home/public/media
MEDIA_PRIVATE_PATH=/home/private/media
MEDIA_LOG_DIR=/var/log
# Comma-separated real mount points the library symlinks into, e.g.
# /media/hd01,/media/hd02
MEDIA_ALLOWED_MOUNTS=

MEDIA_SEARCH_INDEX=/home/private/media/search
# Apache mod_xsendfile serves downloads/streams. Set false for `php artisan serve`.
MEDIA_XSENDFILE=true

# --- Servers ---------------------------------------------------------------
MEDIA01_HOST=media01
MEDIA01_USER=root
MEDIA01_SSH=ssh22
MEDIA01_ROOT=/sharedfolders/Video
MEDIA_PHP_BINARY=/usr/bin/php8.4

# --- Tools page links --------------------------------------------------------
MEDIA_LINK_SSH=
MEDIA_LINK_TRANSMISSION=
